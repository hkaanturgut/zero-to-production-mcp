{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION=canadacentral}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "dmsApiKey": { "value": "${DMS_API_KEY}" },
    "mcpCommand": { "value": "${MCP_COMMAND=live-server}" },
    "assignManagerRoleToDeployer": { "value": "${ASSIGN_MANAGER_ROLE=false}" },
    "agentPrincipalIds": { "value": "${AGENT_PRINCIPAL_IDS}" },
    "deployFoundry": { "value": "${DEPLOY_FOUNDRY=false}" },
    "mcpExists": { "value": "${SERVICE_MCP_RESOURCE_EXISTS=false}" },
    "dmsExists": { "value": "${SERVICE_DMS_RESOURCE_EXISTS=false}" }
  }
}
