# Copy to .env for local runs. Never commit .env.
DMS_API_KEY=change-me-long-random-string
DMS_BASE_URL=http://127.0.0.1:8081

# local = offline dev tokens from `uv run dev-token`; entra = Microsoft Entra ID
AUTH_MODE=local
PUBLIC_BASE_URL=http://127.0.0.1:8080
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

DISCOUNT_LIMIT=500

# Shared across replicas so confirmations work on any of them (32+ bytes each;
# first key seals, all unseal). Generate: python -c "import secrets; print(secrets.token_hex(32))"
# REQUEST_STATE_KEYS=
# Browser origins allowed to call /mcp (default: PUBLIC_BASE_URL)
# ALLOWED_ORIGINS=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
